{
	"name": "@vkma.dev/deploy",
	"version": "0.2.1",
	"description": "Deploy CLI and library for VK Mini Apps hosting. Drop-in compatible with @vkontakte/vk-miniapps-deploy.",
	"type": "module",
	"license": "MIT",
	"author": "pajecawav",
	"homepage": "https://github.com/pajecawav/vkma/tree/master/packages/deploy#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pajecawav/vkma.git",
		"directory": "packages/deploy"
	},
	"bugs": {
		"url": "https://github.com/pajecawav/vkma/issues"
	},
	"keywords": [
		"vk",
		"vkontakte",
		"vk-mini-apps",
		"deploy",
		"hosting",
		"cli",
		"ci"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.18"
	},
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"vkma-deploy": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./schema": "./schema/vkma-deploy.config.schema.json"
	},
	"files": [
		"dist",
		"schema",
		"src",
		"!src/**/*.test.ts",
		"!src/test-utils.ts"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"schema": "node --experimental-strip-types scripts/gen-schema.ts",
		"lint:package": "publint",
		"test": "vitest run",
		"test:watch": "vitest watch"
	},
	"dependencies": {
		"@sinclair/typebox": "^0.34.39",
		"fflate": "^0.8.2"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"publint": "catalog:",
		"tsdown": "catalog:",
		"vitest": "catalog:"
	}
}
