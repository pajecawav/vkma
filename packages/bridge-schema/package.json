{
	"name": "@vkma.dev/bridge-schema",
	"version": "0.1.0",
	"description": "JSON Schema catalogue of VK Bridge events with generated TypeScript types",
	"type": "module",
	"license": "MIT",
	"author": "pajecawav",
	"homepage": "https://github.com/pajecawav/vkma/tree/master/packages/bridge-schema#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pajecawav/vkma.git",
		"directory": "packages/bridge-schema"
	},
	"bugs": {
		"url": "https://github.com/pajecawav/vkma/issues"
	},
	"keywords": [
		"vk",
		"vkontakte",
		"vk-bridge",
		"json-schema",
		"schema",
		"types"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./catalogue": {
			"types": "./dist/catalogue.d.ts",
			"import": "./dist/catalogue.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"import": "./dist/schema.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"generate": "node scripts/generate.ts",
		"build": "pnpm generate && tsdown",
		"dev": "pnpm generate && tsdown --watch",
		"lint:package": "publint",
		"test": "pnpm generate && vitest run",
		"test:watch": "pnpm generate && vitest watch"
	},
	"devDependencies": {
		"@pajecawav/json2code": "catalog:",
		"@types/node": "catalog:",
		"@vkontakte/vk-bridge": "catalog:",
		"publint": "catalog:",
		"tsdown": "catalog:",
		"vitest": "catalog:"
	}
}
