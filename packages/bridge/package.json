{
	"name": "@vkma.dev/bridge",
	"version": "0.2.0",
	"description": "Independent VK Bridge for VK Mini Apps — drop-in API, built-in devtools tap",
	"type": "module",
	"license": "MIT",
	"author": "pajecawav",
	"homepage": "https://github.com/pajecawav/vkma/tree/master/packages/bridge#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pajecawav/vkma.git",
		"directory": "packages/bridge"
	},
	"bugs": {
		"url": "https://github.com/pajecawav/vkma/issues"
	},
	"keywords": [
		"vk",
		"vkontakte",
		"vk-bridge",
		"vk-mini-apps",
		"mini-apps",
		"bridge",
		"typescript"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22"
	},
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint:package": "publint",
		"test": "vitest run",
		"test:watch": "vitest watch"
	},
	"dependencies": {
		"@vkma.dev/bridge-schema": "workspace:^"
	},
	"devDependencies": {
		"happy-dom": "catalog:",
		"publint": "catalog:",
		"tsdown": "catalog:",
		"vitest": "catalog:"
	}
}
