{
	"name": "@vkma.dev/api-schema",
	"version": "0.5199.0",
	"description": "Generated TypeScript types, zod and valibot schemas for the VK API",
	"type": "module",
	"license": "MIT",
	"author": "pajecawav",
	"homepage": "https://github.com/pajecawav/vkma/tree/master/packages/api-schema#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pajecawav/vkma.git",
		"directory": "packages/api-schema"
	},
	"bugs": {
		"url": "https://github.com/pajecawav/vkma/issues"
	},
	"keywords": [
		"vk",
		"vkontakte",
		"vk-api",
		"api",
		"json-schema",
		"zod",
		"valibot",
		"types",
		"codegen"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./zod": {
			"types": "./dist/zod.d.ts",
			"import": "./dist/zod.js"
		},
		"./zod/*": {
			"types": "./dist/generated/zod/*.d.ts",
			"import": "./dist/generated/zod/*.js"
		},
		"./valibot": {
			"types": "./dist/valibot.d.ts",
			"import": "./dist/valibot.js"
		},
		"./valibot/*": {
			"types": "./dist/generated/valibot/*.d.ts",
			"import": "./dist/generated/valibot/*.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"generate": "node scripts/generate.ts",
		"build": "pnpm generate && tsdown",
		"dev": "pnpm generate && tsdown --watch",
		"lint:package": "publint",
		"test": "pnpm generate && vitest run",
		"test:watch": "pnpm generate && vitest watch"
	},
	"peerDependencies": {
		"valibot": ">=1.0.0 <2",
		"zod": ">=4.0.0 <5"
	},
	"peerDependenciesMeta": {
		"valibot": {
			"optional": true
		},
		"zod": {
			"optional": true
		}
	},
	"devDependencies": {
		"@pajecawav/json2code": "catalog:",
		"@types/node": "catalog:",
		"publint": "catalog:",
		"tsdown": "catalog:",
		"valibot": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	}
}
