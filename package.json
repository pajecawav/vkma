{
	"name": "ts-template",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22.23.2"
	},
	"homepage": "https://github.com/pajecawav/ts-template#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pajecawav/ts-template.git"
	},
	"bugs": {
		"url": "https://github.com/pajecawav/ts-template/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"README.md"
	],
	"scripts": {
		"build": "cross-env FORCE_COLOR=1 run-p -l build:*",
		"build:todo": "echo 'done'",
		"dev": "cross-env FORCE_COLOR=1 run-p -l dev:*",
		"dev:todo": "echo 'done'",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"lint": "cross-env FORCE_COLOR=1 run-p -l lint:*",
		"lint:oxlint": "oxlint .",
		"lint:tsc": "tsc -b --noEmit",
		"lint:format": "pt format --check",
		"lint:package": "publint",
		"format": "pt format",
		"prepare": "pt prepare",
		"prepublishOnly": "npm-run-all -p -l lint:* test -s build"
	},
	"devDependencies": {
		"@pajecawav/tools": "^0.1.0",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.5",
		"@vitest/ui": "^5.0.5",
		"cross-env": "^10.1.0",
		"husky": "^9.1.7",
		"npm-run-all2": "^9.0.3",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"oxlint-tsgolint": "^7.0.2004",
		"publint": "^0.3.25",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@12.14.0"
}
