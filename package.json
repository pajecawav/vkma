{
	"name": "vkma",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"build": "pnpm -r --if-present build",
		"dev": "pnpm -r --if-present --parallel dev",
		"format": "pt format",
		"lint": "run-p -l lint:*",
		"lint:apps": "pnpm --filter './apps/*' exec tsc --noEmit",
		"lint:format": "pt format --check",
		"lint:oxlint": "oxlint .",
		"lint:package": "pnpm -r --if-present --workspace-concurrency=1 lint:package",
		"lint:tsc": "tsc -b --noEmit",
		"test": "pnpm -r --if-present test",
		"changeset": "changeset",
		"version": "changeset version",
		"prepare": "pt prepare"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@pajecawav/tools": "^0.1.0",
		"@types/node": "catalog:",
		"husky": "^9.1.7",
		"npm-run-all2": "catalog:",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"oxlint-tsgolint": "^7.0.2004",
		"typescript": "catalog:"
	}
}
