# The inspector is fetched cross-origin by console `import()` (a classic
# <script> tag needs no CORS) — open it to every origin, it is a public
# debug tool carrying no secrets (the peer id rides the query string).
# The URL is embedded in other people's HTML, so the name stays stable:
# short caching + etag revalidation picks up new releases quickly.
/inspector.js
	Access-Control-Allow-Origin: *
	Access-Control-Allow-Methods: GET, HEAD, OPTIONS
	Cache-Control: public, max-age=300

# Hashed panel assets — content-addressed, safe to cache forever.
/lib-*.js
	Cache-Control: public, max-age=31536000, immutable
/index-*.js
	Cache-Control: public, max-age=31536000, immutable
/index-*.css
	Cache-Control: public, max-age=31536000, immutable
