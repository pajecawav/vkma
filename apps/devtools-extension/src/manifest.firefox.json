{
	"manifest_version": "3",
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"name": "vkma devtools",
	"description": "VK Bridge devtools for VK Mini Apps — event timeline and execute on any vk.ru page",
	"version": "0.0.0",
	"browser_specific_settings": {
		"gecko": {
			"id": "devtools@vkma.dev"
		}
	},
	"permissions": ["storage", "tabs"],
	"action": {
		"default_title": "vkma devtools — open the panel in a tab",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"background": {
		"scripts": ["background.js"],
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": [
				"*://vk.com/*",
				"*://vk.ru/*",
				"*://*.vk.com/*",
				"*://*.vk.ru/*",
				"*://web.vk.me/*",
				"*://*.dzen.ru/*",
				"*://*.ok.ru/*",
				"*://*.okcdn.ru/*",
				"*://*.gameroom.games.mail.ru/*",
				"*://vkvideo.ru/*",
				"*://*.vkvideo.ru/*",
				"*://max.ru/*"
			],
			"js": ["host.js"],
			"run_at": "document_end"
		},
		{
			"matches": ["http://*/*", "https://*/*"],
			"js": ["frame.js"],
			"all_frames": true,
			"run_at": "document_start"
		},
		{
			"matches": ["http://*/*", "https://*/*"],
			"js": ["relay.js"],
			"all_frames": true,
			"run_at": "document_start",
			"world": "MAIN"
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["panel.html", "static/*"],
			"matches": [
				"*://vk.com/*",
				"*://vk.ru/*",
				"*://*.vk.com/*",
				"*://*.vk.ru/*",
				"*://web.vk.me/*",
				"*://*.dzen.ru/*",
				"*://*.ok.ru/*",
				"*://*.okcdn.ru/*",
				"*://*.gameroom.games.mail.ru/*",
				"*://vkvideo.ru/*",
				"*://*.vkvideo.ru/*",
				"*://max.ru/*"
			]
		}
	]
}
