---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import MobileMenu from "../components/MobileMenu.astro";
import SearchDialog from "../components/SearchDialog.astro";
import { localeOf } from "../lib/docs";
import { allDocs, navFor, quickLinks } from "../lib/navigation";

interface Props {
	/** The 404 page's collection id: `404` or `en/404`. */
	id: string;
}

const { id } = Astro.props;
const entry = await getEntry("docs", id);
if (!entry) {throw new Error(`docs: the "${id}" page is missing`);}
const { Content } = await render(entry);
const locale = localeOf(id);
const nav = navFor(await allDocs(), locale);
---

<Base title={entry.data.title} description={entry.data.description} locale={locale} id={id}>
	<Header locale={locale} altHref={undefined} />
	<div class="shell is-single">
		<main class="main" id="main" tabindex="-1">
			<article class="doc">
				<header class="doc-head">
					<h1>{entry.data.title}</h1>
				</header>
				<div class="prose">
					<Content />
				</div>
			</article>
		</main>
	</div>
	<MobileMenu nav={nav} current={entry} locale={locale} altHref={undefined} />
	<SearchDialog locale={locale} quick={quickLinks(nav)} />
</Base>
