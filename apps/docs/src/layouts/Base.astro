---
import "@fontsource-variable/inter/opsz.css";
import "@fontsource-variable/geist-mono";
import "../styles/base.css";
import "../styles/shell.css";
import { LOCALES, t } from "../lib/i18n";
import { bareId, localize, urlOf } from "../lib/docs";
import type { Locale } from "../lib/i18n";

interface Props {
	title: string;
	description?: string;
	locale: Locale;
	/** The collection id the canonical and alternate URLs derive from. */
	id: string;
}

const SITE_NAME = "vkma.dev";
const { title, description = "", locale, id } = Astro.props;
const bare = bareId(id);
const canonical = urlOf(id);

// the theme is set before the first paint: a stored choice, else the system's
const themeInit = `(function(){try{var k="vkma-theme",t=localStorage.getItem(k);if(t!=="light"&&t!=="dark"){var o=localStorage.getItem("starlight-theme");t=o==="light"||o==="dark"?o:matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"}document.documentElement.dataset.theme=t;}catch(e){}document.documentElement.classList.add("js");})();`;
---

<!doctype html>
<html lang={locale} dir="ltr" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline set:html={themeInit} />
		<title>{title} | {SITE_NAME}</title>
		<meta name="generator" content={Astro.generator} />
		{description && <meta name="description" content={description} data-pagefind-meta="description[content]" />}
		<link rel="canonical" href={canonical} />
		{
			LOCALES.map(l => (
				<link rel="alternate" hreflang={l} href={urlOf(localize(l, bare))} />
			))
		}
		<link rel="alternate" hreflang="x-default" href={urlOf(localize("ru", bare))} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="shortcut icon" href="/favicon.svg" type="image/svg+xml" />
		<meta property="og:title" content={title} />
		<meta property="og:type" content="article" />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={locale} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:image" content="https://vkma.dev/og.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content="https://vkma.dev/og.png" />
		<meta name="color-scheme" content="dark light" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#17181c" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
	</head>
	<body>
		<a class="skip" href="#main">{t(locale).skip}</a>
		<slot />
		<script>
			import "../scripts/site";
		</script>
	</body>
</html>
